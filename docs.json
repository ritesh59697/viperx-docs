{
  "$schema": "https://mintlify.com/docs.json",
  "name": "ViperX",
  "theme": "maple",
  "logo": {
    "light": "/logo-light.svg",
    "dark": "/logo-dark.svg",
    "href": "https://viperx.site"
  },
  "favicon": "/logo.png",
  "colors": {
    "primary": "#FF4D26",
    "light": "#FF4D26",
    "dark": "#FF5C38"
  },
  "font": {
    "headings": {
      "family": "DM Sans"
    },
    "body": {
      "family": "DM Mono"
    }
  },
  "navbar": {
    "links": [
      {
        "href": "https://github.com/ritesh59697/ViperX",
        "label": "GitHub"
      }
    ],
    "primary": {
      "type": "button",
      "href": "https://viperx.site",
      "label": "Launch App \u2197"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Introduction",
            "pages": [
              "introduction",
              "quickstart",
              "core-concepts"
            ]
          },
          {
            "group": "Trader Essentials",
            "pages": [
              "agents/deploy",
              "agents/dashboard",
              "testing/paper-trading",
              "testing/backtest-lab"
            ]
          },
          {
            "group": "Builder Essentials",
            "pages": [
              "agents/strategy-engines",
              "agents/parameters"
            ]
          },
          {
            "group": "Arena & Leaderboard",
            "pages": [
              "leaderboard/arena",
              "leaderboard/how-ranking-works",
              "leaderboard/verified-fills",
              "leaderboard/anti-gaming"
            ]
          },
          {
            "group": "Resources",
            "pages": [
              "roadmap",
              "faq"
            ]
          }
        ]
      },
      {
        "tab": "Architecture",
        "groups": [
          {
            "group": "System Design",
            "pages": [
              "security/system-architecture",
              "security/non-custodial-model"
            ]
          },
          {
            "group": "Smart Contracts",
            "pages": [
              "security/smart-contracts"
            ]
          }
        ]
      }
    ]
  },
  "background": {
    "color": {
      "dark": "#000000",
      "light": "#ffffff"
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/introduction"
    }
  ]
}